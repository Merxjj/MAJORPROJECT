<%layout('layouts/boilerplate')%>
<div class="row mt-3">
<div class = "col-8 offset-2">
    <h2>Edit this Listing</h2>
    <form method = "POST" action = "/listings/<%=listing._id%>?_method=PUT">
        <div class = "mb-3">
            <label for="title" class = "form-label">Title</label>
            <input name = "listing[title]"type="text" value = "<%=listing.title%>" class = "form-control">
        </div>
        <div class = "mb-3">
            <label for="description" >Description</label>
            <textarea name = "listing[description]" type = "text" class = "form-control" ><%=listing.description%></textarea>

        </div>
        <div class="row">

            <div class="mb-3 col-md-4">
                <label for="price" class = "form-label">Price</label>
                <input name = "listing[price]" type="text" value = "<%=listing.price%>" class = "form-control">
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class = "form-label ">Country</label>
                <input name = "listing[country]" type="text" value = "<%=listing.country%>" class = "form-control">
            </div>
        </div>
        <div>
            <label for="location" class = "form-label ">Country</label>
            <input name = "listing[location]" type="text" value = "<%=listing.location%>" class = "form-control">
        </div>
        <button btn class = "btn btn-dark mt-3 edit-btn" >Update</button>
        </form>
</div>
</div>