<%layout('/layouts/boilerplate')%>

<div class = "row mt-3">    
<div class = "col-8 offset-2">
    <h3 class = "mt-3">Create New Listing</h3>
    <form method = "POST" action = "/listings" novalidate>
        <div class="mb-3">
            <label for="title" class = "form-label">Title</label>
            <input name = "listing[title]"type="text" placeholder="enter cachy title" class = "form-control" required>
        </div>
        <div class="mb-3">
            <label for="description" >Description</label>
                <textarea name = "listing[description]" type = "text" placeholder="enter description" class = "form-control" required></textarea>
        </div>
        <div class="row">

            <div class="mb-3 col-md-4">
                <label for="price" class = "form-label">Price</label>
            <input name = "listing[price]" type="text" placeholder="enter price" class = "form-control" required>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class = "form-label ">Country</label>
                <input name = "listing[country]" type="text" placeholder="India" class = "form-control" required>
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class = "form-label">Location</label>
            <input name = "listing[location]" type="text" placeholder="enter location" class = "form-control" required>
        </div>
        <button class = "btn btn-dark add-btn" >Create</button>
        </form>
</div>
</div>
